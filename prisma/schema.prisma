// Pequita — esquema de la base de datos (SQLite local)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum StickerType {
  ESQUELA
  DECORATIVO
  FOTO
  ESCANEO
}

enum BackgroundType {
  PRESET
  CUSTOM
}

model Sticker {
  id        String      @id @default(cuid())
  type      StickerType
  imageUrl  String
  name      String?
  width     Int?
  height    Int?
  createdAt DateTime    @default(now())

  lettersUsingAsEsquela Letter[] @relation("EsquelaSticker")
}

// Presencia: una fila por persona ("zorro" y "rosa") con la hora de su último
// latido. El contador es un sitio estático en otro dominio, así que dos
// navegadores no pueden verse entre ellos: esta tabla es el único lugar común.
// No guarda historial, ni IP, ni nada más que una hora que se pisa a sí misma.
model Presencia {
  quien   String   @id
  vistoEn DateTime @default(now())
}

// Frasco: lo que cada uno lleva juntado en el contador (luciérnagas, días,
// versos, récord del juego), en JSON. Una fila por persona, y solo la
// escriben los aparatos marcados. El servidor nunca pisa: funde (ver la ruta).
model Frasco {
  quien       String   @id
  datos       String   @default("{}")
  actualizado DateTime @default(now())
}

// Lista de deseos: quién se apuntó a regalar cada cosa. El catálogo de regalos
// vive en el código (`lib/regalos.ts`, que no cambia solo); aquí queda nada más
// el "check" compartido, para que dos familiares no le compren lo mismo. Una
// fila por regalo apartado: si nadie lo tomó, no hay fila.
model RegaloTomado {
  regaloId String   @id
  quien    String
  tomadoEn DateTime @default(now())
}

model Letter {
  id                  String         @id @default(cuid())
  slug                String         @unique @default(cuid())
  title               String         @default("Sin título")

  // Autoría: cuando la carta llega desde la página pública /escribir, guardamos
  // el nombre del familiar y su mensaje original (fuente de la esquela). Si
  // authorName es null, la carta es del dueño (creada en el editor privado).
  authorName          String?
  authorMessage       String?

  // Audio-carta: mensaje de voz opcional grabado por el familiar (URL al blob)
  audioUrl            String?

  // Vídeo-saludo breve (15-20s) opcional; se compilan en la "película" final.
  videoUrl            String?

  // Fotos que viajan en su PROPIO sobrecito, aparte de la hoja escrita (es lo
  // que pasa por defecto desde 2026-08-02). JSON: [{"url":…,"ratio":…}].
  // Si es null, o la carta es anterior, las fotos van pegadas en la esquela.
  photosJson          String?

  // Token secreto para que el autor corrija su carta mientras esté pendiente.
  editToken           String?  @unique

  // Esquela (contenido interior)
  esquelaStickerId    String?
  esquelaSticker      Sticker?       @relation("EsquelaSticker", fields: [esquelaStickerId], references: [id])
  esquelaCanvas       String         @default("{\"elements\":[],\"canvasWidth\":1000,\"canvasHeight\":1400}")
  esquelaBaseImageUrl String?

  // Sobre
  sobreCanvas         String         @default("{\"elements\":[],\"canvasWidth\":1400,\"canvasHeight\":900}")
  sobreBaseImageUrl   String?
  sobreColor          String?        @default("#d6c7a1")

  // Fondo temático del presentador
  backgroundType      BackgroundType @default(PRESET)
  backgroundPresetId  String?
  backgroundImageUrl  String?
  backgroundScale     Int?           // px opcional para densidad del tileo

  // QR cacheados (data URLs)
  qrInteriorDataUrl   String?
  qrExteriorDataUrl   String?

  isPublished         Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}
